{#- Schlankes Dokument-Gerüst des Neuaufbaus. Front-Matter-Schnittstelle
    (slug/pre/locale/theme/active/pid/heroLarge/heroSmall/noEn …) unverändert. -#}
{%- set locale = locale or 'de' -%}
{%- set base = pre + ('en/' if locale == 'en' else '') -%}
{%- set snip = 'src/snippets/en/' if locale == 'en' else 'src/snippets/' -%}
{%- set pageDir = permalink | replace('index.html', '') -%}
{%- set pageDirDe = pageDir | replace('en/', '') -%}
{%- set langAltUrl = (pre + pageDirDe) if locale == 'en' else (pre + 'en/' + ('' if noEn else pageDir)) -%}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<script>/* Nicht-Produktivumgebungen (localhost, github.io, Vorschau) senden keine Analytics-Daten. */
if (!/(^|\.)waldgefluester-events\.de$/.test(location.hostname)) {
  window['ga-disable-G-28C3DCXN1S'] = true;
  window['ga-disable-GT-TB6T4KKQ'] = true;
}</script>
{% rawfile snip + slug + '-seo.html' %}
{% if not noEn %}<link rel="alternate" hreflang="de" href="https://waldgefluester-events.de/{{ pageDirDe }}" />
<link rel="alternate" hreflang="en" href="https://waldgefluester-events.de/en/{{ pageDirDe }}" />
<link rel="alternate" hreflang="x-default" href="https://waldgefluester-events.de/{{ pageDirDe }}" />
{% endif %}
<link rel="preload" as="font" type="font/woff2" href="{{ pre }}assets/fonts/quicksand-latin-600-normal.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="{{ pre }}assets/fonts/open-sans-latin-400-normal.woff2" crossorigin>
{% if heroLarge %}<link rel="preload" as="image" href="{{ pre }}{{ heroLarge }}"{% if heroSmall %} media="(min-width: 768px)"{% endif %}>{% endif %}
{% if heroSmall %}<link rel="preload" as="image" href="{{ pre }}{{ heroSmall }}" media="(max-width: 767px)">{% endif %}
<link rel="stylesheet" href="{{ pre }}assets/css/site.css?v=1">
<link rel="icon" href="{{ pre }}wp-content/uploads/2025/01/cropped-WG_faviconW-32x32.png" sizes="32x32">
<link rel="icon" href="{{ pre }}wp-content/uploads/2025/01/cropped-WG_faviconW-192x192.png" sizes="192x192">
<link rel="apple-touch-icon" href="{{ pre }}wp-content/uploads/2025/01/cropped-WG_faviconW-180x180.png">
<meta name="google-site-verification" content="J1A933IXuQTRCjkzWOx2x9RJgZHT_eso6o23zg4I9gU">
<script>/* Google Consent Mode v2: Standard = abgelehnt, bis der Cookie-Hinweis Zustimmung meldet */
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {ad_storage:'denied', ad_user_data:'denied', ad_personalization:'denied', analytics_storage:'denied', wait_for_update:500});
if (localStorage.getItem('wgConsent') === 'granted') {
  gtag('consent', 'update', {ad_storage:'granted', ad_user_data:'granted', ad_personalization:'granted', analytics_storage:'granted'});
}</script>
<script>/* Google Tag (Site Kit) + GTM nur auf der echten Domain laden */
if (/(^|\.)waldgefluester-events\.de$/.test(location.hostname)) {
  var s = document.createElement('script');
  s.src = 'https://www.googletagmanager.com/gtag/js?id=GT-TB6T4KKQ';
  s.async = true;
  document.head.appendChild(s);
  gtag("set","linker",{"domains":["waldgefluester-events.de"]});
  gtag("js", new Date());
  gtag("config", "GT-TB6T4KKQ");
  (function(w,d,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
    var j=d.createElement('script');j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;
    d.head.appendChild(j);})(window,document,'dataLayer','GTM-T6S4LGRG');
}</script>
{% rawfile snip + slug + '-head.html' %}
</head>
<body id="top" class="wg-theme-{{ theme | default('forest') }} page-id-{{ pid }}{{ ' home' if slug == 'index' }}">
<a class="wg-skip-link" href="#main">{{ "Zum Inhalt springen" | t | safe }}</a>
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T6S4LGRG" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
{% include 'partials/header.njk' %}
<main id="main">
{% include ('bodies/en/' if locale == 'en' else 'bodies/') + slug + '.njk' %}
{% include 'partials/kontakt.njk' %}
</main>
<script src="{{ pre }}assets/js/site.js?v=1" defer></script>
{% if eventsMode %}<script src="{{ pre }}assets/js/events.js" data-events-src="{{ pre }}events.json" data-mode="{{ eventsMode }}"{% if eventsMode == 'banner' %} data-target-url="{{ base }}eigene-events/"{% endif %} defer></script>{% endif %}
{% include 'partials/footer.njk' %}
