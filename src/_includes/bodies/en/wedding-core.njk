{% set heroTitle = heroTitle or 'Getting Married in the Forest – Your Dream Wedding in Nature' %}
{{ hero(heroTitle, {}) }}
{{ subnav([{ href: '#location', label: 'Location' }, { href: '#rezensionen', label: 'Reviews' }, { href: '#impressionen', label: 'Impressions' }, { href: '#partner', label: 'Our Caterers' }]) }}
{% set introText %}<p class="p1">Experience the enchanting magic of nature when you choose to get married in the forest – with us, your dream wedding becomes an unforgettable celebration, accompanied by breathtaking scenery, the fresh breeze of nature, and the soothing sound of rustling trees.</p>
{% endset %}
{{ intro(introText) }}
