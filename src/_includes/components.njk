{#
  Saubere Seitenbausteine des Neuaufbaus. Die Makro-API (Namen + Parameter)
  ist identisch zur Enfold-Ära, damit die bestehenden Bodies unverändert
  weiterfunktionieren – nicht mehr benötigte Parameter (Style-Hashes,
  Pfeilrichtungen) werden schlicht ignoriert.

  Mit `{% from "components.njk" import ... with context %}` einbinden –
  die Makros lesen pid/pre/theme/heroLarge/heroSmall/zigimages aus dem Kontext.
#}

{% macro hero(title, o={}) %}
<section class="wg-hero{{ ' wg-hero--calm' if theme == 'mourning' }}">
  {% if heroLarge %}<div class="wg-hero__media" aria-hidden="true">
    <picture>
      {% if heroSmall %}<source media="(max-width: 767px)" srcset="{{ pre }}{{ heroSmall }}">{% endif %}
      <img src="{{ pre }}{{ heroLarge }}" alt="" fetchpriority="high">
    </picture>
  </div>{% endif %}
  <div>
    <h1>{{ title | safe }}</h1>
    {% if o.button != false %}<a class="btn btn--light" href="#kontakt">{{ (o.buttonLabel or 'Jetzt kontaktieren') | t | safe }}</a>{% endif %}
  </div>
  <a class="wg-hero__scroll" href="#main" data-hero-scroll aria-hidden="true" tabindex="-1">↓</a>
</section>
{% endmacro %}

{% macro intro(text, o={}) %}
<section class="wg-intro">
  <div class="wg-container--narrow">{{ text | safe }}</div>
</section>
{% endmacro %}

{% macro zigzag(o) %}
{% set zigimg = zigimages[pid + ':' + (o.cellA if o.arrowFirst else o.cellB)] %}
<section class="wg-split" {% if o.id %}id="{{ o.id }}"{% endif %}>
  <div class="wg-split__media">
    {% if zigimg %}<img src="{{ pre }}{{ zigimg }}" alt="" loading="lazy" decoding="async">{% endif %}
  </div>
  <div class="wg-split__body">
{{ caller() }}</div>
</section>
{% endmacro %}

{% macro sectionQuote(o) %}
<section class="wg-section wg-band" {% if o.id %}id="{{ o.id }}"{% endif %}>
  <div class="wg-container">
    <h2 class="wg-quote" {% if o.headingId %}id="{{ o.headingId }}"{% endif %}>{{ o.title | safe }}</h2>
{{ caller() }}</div>
</section>
{% endmacro %}

{% macro iconList(items, o={}) %}
<ul class="wg-features">
{% for it in items %}  <li><h3>{{ it.title | safe }}</h3><p>{{ it.text | safe }}</p></li>
{% endfor %}</ul>
{% endmacro %}

{% macro planTimeline(steps, o={}) %}
<ol class="wg-steps">
{% for st in steps %}  <li><div class="wg-steps__card"><h3>{{ st.title | safe }}</h3><p>{{ st.text | safe }}</p></div></li>
{% endfor %}</ol>
{% endmacro %}

{% macro ctaButton(label, o={}) %}
<p class="wg-cta-row"><a class="btn" href="{{ o.href or '#kontakt' }}">{{ label | safe }}</a></p>
{% endmacro %}

{% macro contactBridge(heading, text, o={}) %}
<section class="wg-bridge">
  <div class="wg-container--narrow">
    <img src="{{ pre }}wp-content/uploads/2025/01/Ihr_wir_passt-BEIGE-300x225.png" alt="IHR;WIR" width="300" height="225" loading="lazy" decoding="async">
    <h2 class="wg-quote">{{ heading | safe }}</h2>
    {{ text | safe }}
  </div>
</section>
{% endmacro %}

{# ---- Neue Bausteine des Neuaufbaus ---- #}

{% macro subnav(items) %}
<nav class="wg-subnav" aria-label="{{ 'Seitenbereiche' | t | safe }}">
  <ul>
  {% for it in items %}<li><a href="{{ it.href }}">{{ it.label | safe }}</a></li>
  {% endfor %}</ul>
</nav>
{% endmacro %}

{% macro gallery(images, o={}) %}
<div class="wg-gallery">
{% for im in images %}  <figure><a href="{{ pre }}{{ im.full }}" data-lightbox><img src="{{ pre }}{{ im.thumb or im.full }}" alt="{{ im.alt }}" loading="lazy" decoding="async"></a></figure>
{% endfor %}</div>
{% endmacro %}
